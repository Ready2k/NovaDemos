{
  "name": "voice-s2s-backend",
  "version": "1.0.0",
  "description": "Real-time voice-to-voice assistant backend with Amazon Nova Sonic",
  "main": "dist/server.js",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); const pkg=require('./package.json'); fs.writeFileSync('dist/build-info.json', JSON.stringify({version:pkg.version,buildTime:new Date().toISOString(),name:pkg.name}, null, 2));\"",
    "test:transcript": "npm run build && node --test tests/transcript-coalescer.test.js",
    "start": "node dist/server.js",
    "start:sbc": "node dist/sbc/sbc-server.js",
    "dev": "tsc && node dist/server.js"
  },
  "keywords": [
    "websocket",
    "audio",
    "nova-sonic",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1136.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1136.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1136.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1136.0",
    "@aws-sdk/client-polly": "^3.1136.0",
    "@aws-sdk/client-sts": "^3.1136.0",
    "@aws-sdk/credential-provider-ini": "^3.973.16",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "aws4": "^1.12.0",
    "dotenv": "^17.4.2",
    "langfuse": "^3.39.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.5.10",
    "typescript": "^5.6.0"
  }
}
